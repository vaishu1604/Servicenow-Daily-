10. Business Rule
Requirement
Whenever Assignment Group changes
Add work notes
Example
Assignment Group changed from Service Desk to Network Team

Changed By : System Administrator

Date : 2026-07-20 10:30:45
Script
(function executeRule(current, previous) {

    if (current.assignment_group.changes()) {

        current.work_notes =
            "Assignment Group changed from " +
            previous.assignment_group.getDisplayValue() +
            " to " +
            current.assignment_group.getDisplayValue() +
            "\nChanged By: " +
            gs.getUserDisplayName() +
            "\nDate: " +
            gs.nowDateTime();

    }

})(current, previous);

