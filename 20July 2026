7. Business Rule
Requirement
Prevent duplicate active incidents.
Criteria
Same Caller
Same Short Description
Script
(function executeRule(current, previous) {

    if (current.caller_id.nil() || current.short_description.nil()) {
        return;
    }

    var gr = new GlideRecord('incident');

    gr.addActiveQuery();

    gr.addQuery('caller_id', current.caller_id);

    gr.addQuery('short_description', current.short_description);

    gr.query();

    if (gr.next()) {

        gs.addErrorMessage('Active incident already exists.');

        current.setAbortAction(true);

    }

})(current, previous);

8. GlideAjax
Requirement
Return caller email when caller changes.

Script Include
var UserDetails = Class.create();

UserDetails.prototype = Object.extendsObject(AbstractAjaxProcessor, {

    getUserEmail: function() {

        var userSysId = this.getParameter('sysparm_userSysId');

        var gr = new GlideRecord('sys_user');

        if (gr.get(userSysId)) {

            return gr.getValue('email');

        }

        return '';

    },

    type: 'UserDetails'

});
(Client Callable = True)

Client Script
function onChange(control, oldValue, newValue, isLoading) {

    if (isLoading || newValue == '')
        return;

    var ga = new GlideAjax('UserDetails');

    ga.addParam('sysparm_name', 'getUserEmail');

    ga.addParam('sysparm_userSysId', newValue);

    ga.getXMLAnswer(function(response) {

        g_form.addInfoMessage("Caller Email : " + response);

    });

}

