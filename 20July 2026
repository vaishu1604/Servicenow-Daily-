1. Business Rule (Before Update)
Requirement
When an Incident Priority changes to Critical (1), automatically assign it to Network Team only if Assignment Group is empty.
Type
Before Update Business Rule
Script
(function executeRule(current, previous) {

    if (current.priority.changesTo('1')) {

        if (current.assignment_group.nil()) {

            current.assignment_group = 'NETWORK_TEAM_SYS_ID';

        }
    }

})(current, previous);

