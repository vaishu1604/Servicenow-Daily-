// 5. Auto Assign Incident Based on Least Workload
Requirement
When Incident is created,
Find all users in Assignment Group.
Assign the Incident to the user having the minimum number of active incidents.





(function executeRule(current, previous) {

    // If Assignment Group is empty, do nothing
    if (current.assignment_group.nil()) {
        return;
    }

    var leastLoadedUser = '';
    var minCount = 999999;

    // Get all users in the Assignment Group
    var memberGR = new GlideRecord('sys_user_grmember');
    memberGR.addQuery('group', current.assignment_group);
    memberGR.query();

    while (memberGR.next()) {

        var count = 0;

        // Count active incidents assigned to this user
        var ga = new GlideAggregate('incident');
        ga.addActiveQuery();
        ga.addQuery('assigned_to', memberGR.user);
        ga.addAggregate('COUNT');
        ga.query();

        if (ga.next()) {
            count = parseInt(ga.getAggregate('COUNT'), 10);
        }

        // Find user with minimum workload
        if (count < minCount) {
            minCount = count;
            leastLoadedUser = memberGR.user.toString();
        }
    }

    // Assign incident
    if (leastLoadedUser) {
        current.assigned_to = leastLoadedUser;
    }

})(current, previous);

