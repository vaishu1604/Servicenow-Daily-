// 1 . Close Parent Incident Only When All Child Incidents Are Closed 
Requirement
Whenever a child Incident is closed, check if all child incidents of the parent are closed.
If yes → Close the parent.
Otherwise → Do nothing.


(function executeRule(current, previous) {

    if (current.parent.nil()) {
        return;
    }

    var gr = new GlideRecord('incident');
    gr.addActiveQuery();
    gr.addQuery('parent', current.parent);
    gr.query();

    if (!gr.next()) {

        var grt = new GlideRecord('incident');

        if (grt.get(current.parent)) {

            grt.state = 7;
            grt.close_notes = "All child incidents are closed.";
            grt.update();

        }
    }

})(current, previous);







// 2. Prevent Parent Incident from Closing Until All Children Are Closed 
Requirement
User tries to close Parent Incident.
If any child Incident is still Active
→ Prevent save
→ Show error message.



(function executeRule(current, previous) {

    if (current.state.changesTo(7)) {

        var gr = new GlideRecord('incident');
        gr.addActiveQuery();
        gr.addQuery('parent', current.sys_id);
        gr.query();

        if (gr.hasNext()) {

            gs.addErrorMessage("Active child incidents exist. Close them first.");
            current.setAbortAction(true);

        }
    }

})(current, previous);









// 3. Auto Close Related Problem Tasks When Problem is Closed 
Requirement
Whenever a Problem record is Closed
Automatically close all active Problem Tasks.






(function executeRule(current, previous) {

    if (current.state.changesTo(3)) {

        var gr = new GlideRecord('problem_task');
        gr.addActiveQuery();
        gr.addQuery('problem', current.sys_id);
        gr.query();

        while (gr.next()) {

            gr.state = 3;
            gr.close_notes = "All related Problem Tasks closed.";
            gr.update();

        }
    }

})(current, previous);




