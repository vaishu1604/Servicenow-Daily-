//2 . GlideRecord – Auto-Assign Incident
Write a server-side script using GlideRecord or GlideAggregate to find the user with the fewest active incidents in the same assignment group and automatically assign the new incident to that user.

var ga = new GlideAggregate('incident');

ga.addQuery('active', true);
ga.addQuery('assignment_group', current.assignment_group);
ga.addNotNullQuery('assigned_to');

ga.addAggregate('COUNT');
ga.groupBy('assigned_to');
ga.orderByAggregate('COUNT');
ga.setLimit(1);
ga.query();

if (ga.next()) {
    current.assigned_to = ga.getValue('assigned_to');
}
